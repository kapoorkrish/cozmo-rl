<mujoco model="cozmo">
  <compiler angle="radian" meshdir="./assets/meshes" autolimits="true" inertiafromgeom="auto"/>

  <default>
    <joint damping="0.02" armature="0.0005"/>
  </default>

  <asset>
    <mesh name="body3" content_type="model/obj" file="body3.obj"/>
    <mesh name="cozmo_head" content_type="model/obj" file="cozmo_head.obj"/>
    <mesh name="left_upper_arm" content_type="model/obj" file="left_upper_arm.obj" scale="0.001 0.001 0.001"/>
    <mesh name="right_upper_arm" content_type="model/obj" file="right_upper_arm.obj" scale="0.001 0.001 0.001"/>
    <mesh name="left_lower_arm" content_type="model/obj" file="left_lower_arm.obj" scale="0.001 0.001 0.001"/>
    <mesh name="right_lower_arm" content_type="model/obj" file="right_lower_arm.obj" scale="0.001 0.001 0.001"/>
    <model name="fork_model" file="fork.xml"/>

    <material name="body_mat" rgba="0.12 0.12 0.12 1"/>
    <material name="wheel_mat" rgba="0.05 0.05 0.05 1"/>
  </asset>

  <worldbody>
    <!-- Cozmo -->
    <body name="cozmo" pos="0 0 0.03">
      <freejoint name="root"/>

      <!-- Chassis -->
      <geom name="chassis" type="mesh" mesh="body3" material="body_mat" mass="0.06" contype="2" conaffinity="1"/>

      <!-- Head -->
      <body name="head" pos="0.0174507 0 0.022003">
        <joint name="base_to_head" pos="0 0 0" axis="0 -1 0" range="-0.44 0.78" damping="0.05"/>
        <geom type="mesh" mesh="cozmo_head" material="body_mat" mass="0.01" contype="2" conaffinity="1"/>
        <camera name="cozmo_cam" pos="0.020813 0 -0.0071471" quat="0.5 0.5 -0.5 -0.5" fovy="45"/>
      </body>

      <!-- Lift arms -->
      <body name="right_upper_arm" pos="0 0 -0.023">
        <joint name="right_upper_arm_joint" pos="-0.0130 -0.0223 0.0443" axis="0 -1 0" damping="0.05"/>
        <geom type="mesh" mesh="right_upper_arm" material="body_mat" mass="0.0015" contype="2" conaffinity="1"/>
      </body>

      <body name="left_upper_arm" pos="0 0 -0.023">
        <joint name="left_upper_arm_joint" pos="-0.0130 0.0223 0.0443" axis="0 -1 0" damping="0.05"/>
        <geom type="mesh" mesh="left_upper_arm" pos="0 0 -0.001443" material="body_mat" mass="0.0015" contype="2" conaffinity="1"/>
      </body>

      <body name="right_lower_arm" pos="0 0 -0.023">
        <joint name="right_lower_arm_joint" pos="-0.0130 -0.0225 0.0320" axis="0 -1 0" range="-0.04 0.79" limited="true" solreflimit="0.005 1" solimplimit="0.95 0.99 0.001" damping="0.02"/>
        <geom type="mesh" mesh="right_lower_arm" material="body_mat" mass="0.0015" contype="2" conaffinity="1"/>

        <!-- Fork -->
        <attach model="fork_model" body="fork" prefix=""/>
      </body>

      <body name="left_lower_arm" pos="0 0 -0.023">
        <joint name="left_lower_arm_joint" pos="-0.0130 0.0225 0.0320" axis="0 -1 0" range="-0.04 0.79" limited="true" solreflimit="0.005 1" solimplimit="0.95 0.99 0.001" damping="0.02"/>
        <geom type="mesh" mesh="left_lower_arm" pos="0 0 -0.001072" material="body_mat" mass="0.0015" contype="2" conaffinity="1"/>
      </body>

      <!-- Wheels -->
      <body name="front_left_wheel" pos="0.03 0.024 -0.012" quat="0.707107 -0.707107 0 0">
        <joint name="front_left_wheel_joint"  pos="0 0 0" axis="0 0 1" armature="0.001" damping="0.02"/>
        <geom size="0.01314 0.00583695" type="cylinder" material="wheel_mat" friction="1.0 0.005 0.0001" mass="0.01" contype="2" conaffinity="1"/>
      </body>

      <body name="front_right_wheel" pos="0.03 -0.024 -0.012" quat="0.707107 -0.707107 0 0">
        <joint name="front_right_wheel_joint" pos="0 0 0" axis="0 0 1" armature="0.001" damping="0.02"/>
        <geom size="0.01314 0.00583695" type="cylinder" material="wheel_mat" friction="1.0 0.005 0.0001" mass="0.01" contype="2" conaffinity="1"/>
      </body>

      <body name="rear_left_wheel" pos="-0.017 0.024 -0.0151707" quat="0.707107 -0.707107 0 0">
        <joint name="rear_left_wheel_joint" pos="0 0 0" axis="0 0 1" armature="0.001" damping="0.02"/>
        <geom size="0.008995 0.00583695" type="cylinder" material="wheel_mat" friction="1.0 0.005 0.0001" mass="0.01" contype="2" conaffinity="1"/>
      </body>

      <body name="rear_right_wheel" pos="-0.017 -0.024 -0.0151707" quat="0.707107 -0.707107 0 0">
        <joint name="rear_right_wheel_joint" pos="0 0 0" axis="0 0 1" armature="0.001" damping="0.02"/>
        <geom size="0.008995 0.00583695" type="cylinder" material="wheel_mat" friction="1.0 0.005 0.0001" mass="0.01" contype="2" conaffinity="1"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Belt coupling of rear and front wheels, joint1 = 1.4608 * joint2 -->
    <joint joint1="rear_left_wheel_joint" joint2="front_left_wheel_joint" polycoef="0 1.46081156198 0 0 0" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="rear_right_wheel_joint" joint2="front_right_wheel_joint" polycoef="0 1.46081156198 0 0 0" solref="0.01 1" solimp="0.9 0.95 0.001"/>

    <!-- Fork pivots -->
    <connect name="right_upper_pivot" body1="fork" body2="right_upper_arm" anchor="0.0515 -0.0190 0.0305" solref="0.002 1" solimp="0.999 0.9999 0.00001"/>
    <connect name="left_upper_pivot" body1="fork" body2="left_upper_arm" anchor="0.0515 0.0190 0.0305" solref="0.002 1" solimp="0.999 0.9999 0.00001"/>
    <connect name="left_lower_pivot" body1="fork" body2="left_lower_arm" anchor="0.0515 0.0192 0.0182" solref="0.002 1" solimp="0.999 0.9999 0.00001"/>
  </equality>

  <actuator>
    <velocity name="left_front_motor" joint="front_left_wheel_joint" ctrlrange="-15.22 15.22" kv="1.0"/>
    <velocity name="right_front_motor" joint="front_right_wheel_joint" ctrlrange="-15.22 15.22" kv="1.0"/>
    <position name="head_motor" joint="base_to_head" ctrlrange="-0.44 0.78" kp="1"/>
    <position name="lift_motor" joint="right_lower_arm_joint" ctrlrange="-0.20 0.79" kp="1" forcerange="-0.45 0.45"/>
  </actuator>
</mujoco>
