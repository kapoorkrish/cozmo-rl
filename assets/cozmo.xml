<mujoco model="cozmo_real">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <joint damping="0.02" armature="0.0005"/>
    <geom contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
  </default>

  <asset>
    <mesh name="body3" content_type="model/obj" file="body3.obj"/>
    <mesh name="cozmo_head" content_type="model/obj" file="cozmo_head.obj"/>
    <mesh name="cozmo_lift" content_type="model/obj" file="cozmo_lift.obj"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.1"/>
    <material name="body_mat" rgba="0.12 0.12 0.12 1"/>
    <material name="wheel_mat" rgba="0.05 0.05 0.05 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid_mat"/>

    <body name="cozmo" pos="0 0 0.03">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.06" diaginertia="2.785e-05 4.525e-05 4.525e-05"/>

      <geom name="chassis" type="mesh" mesh="body3" material="body_mat" pos="0 0 -0.003"/>

      <camera name="cozmo_cam" pos="0.045 0 0.01" euler="1.5708 0 -1.5708" fovy="70"/>

      <body name="head" pos="0.0174507 0 0.019">
        <inertial pos="0 0 0" mass="0.01" diaginertia="2.60417e-06 2.48083e-06 2.48083e-06"/>
        <joint name="base_to_head" pos="0 0 0" axis="0 1 0" range="-0.52 0.17" damping="0.05"/>
        <geom type="mesh" mesh="cozmo_head" material="body_mat"/>
      </body>

      <body name="full_lift" pos="-0.005 0 0.013">
        <inertial pos="0 0 0" mass="0.01" diaginertia="4.887e-06 7.551e-06 7.551e-06"/>
        <joint name="base_to_lift" pos="0 0 0" axis="0 1 0" range="-0.8 0" damping="0.05"/>
        <geom type="mesh" mesh="cozmo_lift" material="body_mat"/>
      </body>

      <body name="front_left_wheel" pos="0.03 0.024 -0.015" quat="0.707107 -0.707107 0 0">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.01" diaginertia="8.633e-07 5.451e-07 5.451e-07"/>
        <joint name="front_left_wheel_joint" pos="0 0 0" axis="0 0 1"/>
        <geom size="0.01314 0.00583695" type="cylinder" material="wheel_mat" friction="1.3 0.005 0.0001"/>
      </body>

      <body name="front_right_wheel" pos="0.03 -0.024 -0.015" quat="0.707107 -0.707107 0 0">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.01" diaginertia="8.633e-07 5.451e-07 5.451e-07"/>
        <joint name="front_right_wheel_joint" pos="0 0 0" axis="0 0 1"/>
        <geom size="0.01314 0.00583695" type="cylinder" material="wheel_mat" friction="1.3 0.005 0.0001"/>
      </body>

      <body name="rear_left_wheel" pos="-0.017 0.024 -0.0182" quat="0.707107 -0.707107 0 0">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.01" diaginertia="4.046e-07 3.158e-07 3.158e-07"/>
        <joint name="rear_left_wheel_joint" pos="0 0 0" axis="0 0 1"/>
        <geom size="0.008995 0.00583695" type="cylinder" material="wheel_mat" friction="1.3 0.005 0.0001"/>
      </body>

      <body name="rear_right_wheel" pos="-0.017 -0.024 -0.0182" quat="0.707107 -0.707107 0 0">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.01" diaginertia="4.046e-07 3.158e-07 3.158e-07"/>
        <joint name="rear_right_wheel_joint" pos="0 0 0" axis="0 0 1"/>
        <geom size="0.008995 0.00583695" type="cylinder" material="wheel_mat" friction="1.3 0.005 0.0001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_front_motor" joint="front_left_wheel_joint" ctrlrange="-20 20"/>
    <velocity name="left_rear_motor" joint="rear_left_wheel_joint" ctrlrange="-20 20"/>
    <velocity name="right_front_motor" joint="front_right_wheel_joint" ctrlrange="-20 20"/>
    <velocity name="right_rear_motor" joint="rear_right_wheel_joint" ctrlrange="-20 20"/>
  </actuator>
</mujoco>
