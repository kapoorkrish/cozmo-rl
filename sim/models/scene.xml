<mujoco model="cozmo_scene">
  <compiler angle="radian" meshdir="../assets/meshes" autolimits="true" inertiafromgeom="auto"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <map znear="0.0004" zfar="2"/>
    <quality shadowsize="4096"/>
  </visual>

  <include file="room.xml"/>
  <include file="cozmo.xml"/>

  <sensor>
    <!-- Pose and heading
    When level, heading is [cos yaw, sin yaw, 0] -->
    <framepos name="pose" objtype="body" objname="cozmo"/>
    <framexaxis name="pose_xaxis" objtype="body" objname="cozmo"/>

    <!-- Wheel speeds -->
    <jointvel name="lwheel_speed" joint="front_left_wheel_joint"/>
    <jointvel name="rwheel_speed" joint="front_right_wheel_joint"/>

    <!-- Lift and head angles -->
    <jointpos name="lift_angle" joint="right_lower_arm_joint"/>
    <jointpos name="head_angle" joint="base_to_head"/>
  </sensor>
</mujoco>